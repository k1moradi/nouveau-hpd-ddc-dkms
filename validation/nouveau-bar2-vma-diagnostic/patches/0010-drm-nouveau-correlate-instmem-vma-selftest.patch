diff --git a/drivers/gpu/drm/nouveau/nvkm/subdev/instmem/nv50.c b/drivers/gpu/drm/nouveau/nvkm/subdev/instmem/nv50.c
index 6fbaa1e..b9993cf 100644
--- a/drivers/gpu/drm/nouveau/nvkm/subdev/instmem/nv50.c
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/instmem/nv50.c
@@ -307,6 +307,30 @@ nv50_instobj_bar2(struct nvkm_memory *memory)
 	return addr;
 }
 
+#if IS_ENABLED(CONFIG_DRM_NOUVEAU_SELFTEST)
+static int
+nv50_instobj_bar2_vma_snapshot(struct nvkm_memory *memory,
+			       u64 *addr, u64 *size)
+{
+	struct nv50_instobj *iobj = nv50_instobj(memory);
+	struct nvkm_instmem *imem = &iobj->imem->base;
+	int ret = -ENXIO;
+
+	if (!addr || !size)
+		return -EINVAL;
+
+	/* The caller holds a kmap reference, so this VMA cannot be evicted. */
+	mutex_lock(&imem->mutex);
+	if (refcount_read(&iobj->maps) > 0 && iobj->bar && iobj->map) {
+		*addr = iobj->bar->addr;
+		*size = iobj->bar->size;
+		ret = 0;
+	}
+	mutex_unlock(&imem->mutex);
+	return ret;
+}
+#endif
