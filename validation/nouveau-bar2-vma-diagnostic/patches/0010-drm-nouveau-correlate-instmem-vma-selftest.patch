+static atomic64_t nouveau_selftest_instmem_test_id = ATOMIC64_INIT(0);
+
+struct nouveau_selftest_vma_snapshot {
+	bool valid;
+	u64 start;
+	u64 size;
+};
+
+static void
+nouveau_debugfs_selftest_instmem_log_vma(struct device *device, u64 test_id,
+					 const char *stage, const void *object,
+					 struct nvkm_memory *memory, bool refresh,
+					 struct nouveau_selftest_vma_snapshot *snapshot)
+{
+	u64 start, size;
+	int lookup = -EOPNOTSUPP;
+	bool current_vma = false;
+	const char *range_source;
+
+	if (refresh && memory) {
+		lookup = nvkm_memory_bar2_vma_snapshot(memory, &start, &size);
+		if (!lookup) {
+			snapshot->start = start;
+			snapshot->size = size;
+			snapshot->valid = true;
+			current_vma = true;
+		}
+	}
+	range_source = current_vma ? "current" :
+		       snapshot->valid ? "last_observed" : "unavailable";
+
+	dev_info(device,
+		 "NOUVEAU_DIAG_V3_VMA vmm=BAR2 id=%llu stage=%s obj=%p src=%s va=%#llx len=%#llx rc=%d\n",
+		 (unsigned long long)test_id, stage, object, range_source,
+		 (unsigned long long)(snapshot->valid ? snapshot->start : 0),
+		 (unsigned long long)(snapshot->valid ? snapshot->size : 0),
+		 refresh ? lookup : 0);
+}
 
