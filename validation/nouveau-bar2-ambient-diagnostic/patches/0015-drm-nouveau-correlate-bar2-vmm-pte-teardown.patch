diff --git a/drivers/gpu/drm/nouveau/nvkm/subdev/bar/base.c b/drivers/gpu/drm/nouveau/nvkm/subdev/bar/base.c
index 779ba3df2d0ae8064d1b8bfacb109abe5036a436..8dadd8c2595019e2db728194ee6c92156a42e5d4 100644
--- a/drivers/gpu/drm/nouveau/nvkm/subdev/bar/base.c
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/bar/base.c
@@ -38,0 +39 @@ static atomic64_t nvkm_bar2_diag_gen = ATOMIC64_INIT(0);
+static atomic64_t nvkm_bar2_diag_vmm_op = ATOMIC64_INIT(0);
@@ -143,0 +145,58 @@ nvkm_bar2_diag_enabled(void)
+u64
+nvkm_bar2_diag_vmm_operation(void)
+{
+	return atomic64_inc_return(&nvkm_bar2_diag_vmm_op);
+}
+
+void
+nvkm_bar2_diag_vmm_phase(const struct nvkm_bar2_vmm_diag *diag,
+			 enum nvkm_bar2_vmm_diag_phase phase,
+			 u64 pt_id, u64 pte_va,
+			 u32 pte_first, u32 pte_count, u8 pte_shift,
+			 int flush_depth)
+{
+	static const char * const phases[] = {
+		[NVKM_BAR2_VMM_PUT_BEGIN] = "VMM_PUT_BEGIN",
+		[NVKM_BAR2_VMM_PTE_UNMAP_BEGIN] = "PTE_UNMAP_BEGIN",
+		[NVKM_BAR2_VMM_PTE_WRITE_DONE] = "PTE_WRITE_DONE",
+		[NVKM_BAR2_VMM_PT_LAST_REF_BEGIN] = "PT_LAST_REF_BEGIN",
+		[NVKM_BAR2_VMM_PT_LAST_REF_DONE] = "PT_LAST_REF_DONE",
+		[NVKM_BAR2_VMM_FLUSH_BEGIN] = "VMM_FLUSH_BEGIN",
+		[NVKM_BAR2_VMM_FLUSH_DONE] = "VMM_FLUSH_DONE",
+		[NVKM_BAR2_VMM_VMA_RANGE_RELEASE] = "VMA_RANGE_RELEASE",
+		[NVKM_BAR2_VMM_PUT_DONE] = "VMM_PUT_DONE",
+	};
+	char message[512];
+	u64 map_reset_gen;
+	size_t length;
+
+	if (!diag || !nvkm_bar2_diag_enabled() ||
+	    (unsigned int)phase >= ARRAY_SIZE(phases) || !phases[phase])
+		return;
+
+	map_reset_gen = diag->map_reset_valid ? diag->map_reset_gen : 0;
+
+	length = scnprintf(message, sizeof(message),
+			   "NOUVEAU_DIAG_BAR2_VMM seq=%llu op=%llu target_id=%llu phase=%s",
+			   (unsigned long long)nvkm_bar2_diag_sequence(),
+			   (unsigned long long)diag->operation_id,
+			   (unsigned long long)diag->target_id, phases[phase]);
+	length += scnprintf(message + length, sizeof(message) - length,
+			     " target_va=%#llx target_len=%#llx target_map_refs=%u",
+			     (unsigned long long)diag->target_va,
+			     (unsigned long long)diag->target_len,
+			     diag->target_map_refs);
+	length += scnprintf(message + length, sizeof(message) - length,
+			     " pt_id=%llu pte_va=%#llx pte_first=%u pte_count=%u",
+			     (unsigned long long)pt_id, (unsigned long long)pte_va,
+			     pte_first, pte_count);
+	length += scnprintf(message + length, sizeof(message) - length,
+			     " pte_shift=%u map_reset_valid=%u map_reset_gen=%llu",
+			     pte_shift, diag->map_reset_valid,
+			     (unsigned long long)map_reset_gen);
+	scnprintf(message + length, sizeof(message) - length,
+		  " current_reset_gen=%llu flush_depth=%d",
+		  (unsigned long long)nvkm_bar2_diag_reset_generation(), flush_depth);
+	nvkm_bar2_diag_ring_record(message);
+}
+
