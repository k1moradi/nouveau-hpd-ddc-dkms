+	if (ret)
+		return ret;
+#endif
+
@@ -1476,0 +1484,3 @@
+#if IS_ENABLED(CONFIG_DRM_NOUVEAU_SELFTEST)
+		nvkm_bar2_diag_ring_fini();
+#endif
@@ -1506,0 +1517,3 @@
+#if IS_ENABLED(CONFIG_DRM_NOUVEAU_SELFTEST)
+	nvkm_bar2_diag_ring_fini();
+#endif

diff --git a/drivers/gpu/drm/nouveau/nvkm/subdev/bar/base.c b/drivers/gpu/drm/nouveau/nvkm/subdev/bar/base.c
index 4e83069..2e4adb2 100644
--- a/drivers/gpu/drm/nouveau/nvkm/subdev/bar/base.c
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/bar/base.c
@@ -27,0 +28,2 @@
+#include <linux/bitops.h>
+#include <linux/ktime.h>
@@ -28,0 +31 @@
+#include <linux/slab.h>
@@ -35,0 +39,98 @@
+
+#define NVKM_BAR2_DIAG_RING_ORDER 17
+#define NVKM_BAR2_DIAG_RING_SIZE BIT(NVKM_BAR2_DIAG_RING_ORDER)
+#define NVKM_BAR2_DIAG_MESSAGE_SIZE 512
+
+struct nvkm_bar2_diag_event {
+	u64 published;
+	u64 mono_ns;
+	char message[NVKM_BAR2_DIAG_MESSAGE_SIZE];
+};
+
+static struct nvkm_bar2_diag_event *nvkm_bar2_diag_events;
+static atomic64_t nvkm_bar2_diag_ring_next = ATOMIC64_INIT(0);
+static atomic64_t nvkm_bar2_diag_ring_drop_count = ATOMIC64_INIT(0);
+
+int
+nvkm_bar2_diag_ring_init(void)
+{
+	if (!nvkm_bar2_diag_enabled())
+		return 0;
+
+	nvkm_bar2_diag_events = kvcalloc(NVKM_BAR2_DIAG_RING_SIZE,
+					 sizeof(*nvkm_bar2_diag_events), GFP_KERNEL);
+	if (!nvkm_bar2_diag_events)
+		return -ENOMEM;
+
+	atomic64_set(&nvkm_bar2_diag_ring_next, 0);
+	atomic64_set(&nvkm_bar2_diag_ring_drop_count, 0);
+	return 0;
+}
+
+void
+nvkm_bar2_diag_ring_fini(void)
+{
+	kvfree(nvkm_bar2_diag_events);
+	nvkm_bar2_diag_events = NULL;
+}
+
+void
+nvkm_bar2_diag_ring_record(const char *message)
+{
+	struct nvkm_bar2_diag_event *events = READ_ONCE(nvkm_bar2_diag_events);
+	struct nvkm_bar2_diag_event *event;
+	u64 index;
+
+	if (!nvkm_bar2_diag_enabled() || !events)
+		return;
+
+	index = atomic64_fetch_inc(&nvkm_bar2_diag_ring_next);
+	if (index >= NVKM_BAR2_DIAG_RING_SIZE) {
+		atomic64_inc(&nvkm_bar2_diag_ring_drop_count);
+		return;
+	}
+
+	event = &events[index];
+	event->mono_ns = ktime_get_mono_fast_ns();
+	if (strscpy(event->message, message, sizeof(event->message)) < 0) {
+		atomic64_inc(&nvkm_bar2_diag_ring_drop_count);
+		return;
+	}
+	/* Publish only after the timestamp and message are fully written. */
+	smp_store_release(&event->published, index + 1);
+}
+
+u64
+nvkm_bar2_diag_ring_capacity(void)
+{
+	return NVKM_BAR2_DIAG_RING_SIZE;
+}
+
+u64
+nvkm_bar2_diag_ring_head(void)
+{
+	return atomic64_read(&nvkm_bar2_diag_ring_next);
+}
+
+u64
+nvkm_bar2_diag_ring_dropped(void)
+{
+	return atomic64_read(&nvkm_bar2_diag_ring_drop_count);
+}
+
+bool
+nvkm_bar2_diag_ring_read(u64 index, u64 *mono_ns, char *message,
+			 size_t message_size)
+{
+	struct nvkm_bar2_diag_event *events = READ_ONCE(nvkm_bar2_diag_events);
+	struct nvkm_bar2_diag_event *event;
+
+	if (!events || index >= NVKM_BAR2_DIAG_RING_SIZE || !message_size)
+		return false;
+	event = &events[index];
+	/* Pair with the producer release before reading the completed slot. */
+	if (smp_load_acquire(&event->published) != index + 1)
+		return false;
+	*mono_ns = READ_ONCE(event->mono_ns);
+	return strscpy(message, event->message, message_size) >= 0;
+}
@@ -106,0 +208,2 @@
+			char message[128];
+
@@ -108,2 +211,2 @@
-			nvkm_info(&bar->subdev,
-				  "NOUVEAU_DIAG_BAR2_RESET seq=%llu gen=%llu stage=BEGIN\n",
+			scnprintf(message, sizeof(message),
+				  "NOUVEAU_DIAG_BAR2_RESET seq=%llu gen=%llu stage=BEGIN",
@@ -111,0 +215 @@
+			nvkm_bar2_diag_ring_record(message);
@@ -117,3 +221,5 @@
-		if (diag)
-			nvkm_info(&bar->subdev,
-				  "NOUVEAU_DIAG_BAR2_RESET seq=%llu gen=%llu stage=END\n",
+		if (diag) {
+			char message[128];
+
+			scnprintf(message, sizeof(message),
+				  "NOUVEAU_DIAG_BAR2_RESET seq=%llu gen=%llu stage=END",
@@ -121,0 +228,2 @@
+			nvkm_bar2_diag_ring_record(message);
+		}

diff --git a/drivers/gpu/drm/nouveau/nvkm/subdev/instmem/nv50.c b/drivers/gpu/drm/nouveau/nvkm/subdev/instmem/nv50.c
index 33857e3..adb0f38 100644
--- a/drivers/gpu/drm/nouveau/nvkm/subdev/instmem/nv50.c
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/instmem/nv50.c
@@ -102,0 +103 @@
+	(void)subdev;
@@ -142 +143 @@
-	nvkm_info(subdev, "%s\n", message);
+	nvkm_bar2_diag_ring_record(message);
