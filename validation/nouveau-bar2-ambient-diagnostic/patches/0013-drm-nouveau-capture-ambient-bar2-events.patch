From: Keivan Moradi <18602635+k1moradi@users.noreply.github.com>
Subject: [PATCH] drm/nouveau: capture ambient BAR2 events in a bounded ring

Store ambient BAR2 map and reset events in a preallocated ring instead of
flooding printk. The read-only debugfs snapshot records a monotonic cutoff
and immutable index prefix, and reports overflow, gaps, or cutoff races.

The ring is allocated only when diag_bar2_map is enabled. Event paths use
fixed memory, atomics, and monotonic timestamps. They add no VMM walk, MMIO
read, sleeping lock, or allocation.

Signed-off-by: Keivan Moradi <18602635+k1moradi@users.noreply.github.com>

diff --git a/drivers/gpu/drm/nouveau/include/nvkm/subdev/bar.h b/drivers/gpu/drm/nouveau/include/nvkm/subdev/bar.h
index 7b9c7b9..1497480 100644
--- a/drivers/gpu/drm/nouveau/include/nvkm/subdev/bar.h
+++ b/drivers/gpu/drm/nouveau/include/nvkm/subdev/bar.h
@@ -31,0 +32,8 @@
+int nvkm_bar2_diag_ring_init(void);
+void nvkm_bar2_diag_ring_fini(void);
+void nvkm_bar2_diag_ring_record(const char *message);
+u64 nvkm_bar2_diag_ring_capacity(void);
+u64 nvkm_bar2_diag_ring_head(void);
+u64 nvkm_bar2_diag_ring_dropped(void);
+bool nvkm_bar2_diag_ring_read(u64 index, u64 *mono_ns, char *message,
+			      size_t message_size);

diff --git a/drivers/gpu/drm/nouveau/nouveau_debugfs.c b/drivers/gpu/drm/nouveau/nouveau_debugfs.c
index 27453dc..09723c2 100644
--- a/drivers/gpu/drm/nouveau/nouveau_debugfs.c
+++ b/drivers/gpu/drm/nouveau/nouveau_debugfs.c
@@ -35,0 +36,2 @@
+#include <linux/ktime.h>
+#include <linux/seq_file.h>
@@ -42,0 +45 @@
+#include <nvkm/subdev/bar.h>
@@ -1108,0 +1112,144 @@
+#if IS_ENABLED(CONFIG_DRM_NOUVEAU_SELFTEST)
+struct nouveau_bar2_diag_dump {
+	u64 capacity;
+	u64 head;
+	u64 dropped;
+	u64 captured;
+	u64 cutoff_ns;
+	u64 index;
+};
+
+static char nouveau_bar2_diag_end_token;
+
+static void *
+nouveau_bar2_diag_seq_start(struct seq_file *m, loff_t *pos)
+{
+	struct nouveau_bar2_diag_dump *dump = m->private;
+
+	if (*pos == 0) {
+		/*
+		 * Ring producers reserve an index before timestamping it. Taking
+		 * the cutoff before head means every event timestamped at or
+		 * before the cutoff has already reserved an index in this prefix.
+		 */
+		dump->cutoff_ns = ktime_get_mono_fast_ns();
+		dump->capacity = nvkm_bar2_diag_ring_capacity();
+		dump->head = nvkm_bar2_diag_ring_head();
+		dump->dropped = nvkm_bar2_diag_ring_dropped();
+		dump->captured = min_t(u64, dump->head, dump->capacity);
+		return SEQ_START_TOKEN;
+	}
+	if (*pos <= dump->captured) {
+		dump->index = *pos - 1;
+		return dump;
+	}
+	if (*pos == dump->captured + 1)
+		return (void *)&nouveau_bar2_diag_end_token;
+	return NULL;
+}
+
+static void *
+nouveau_bar2_diag_seq_next(struct seq_file *m, void *v, loff_t *pos)
+{
+	++*pos;
+	return nouveau_bar2_diag_seq_start(m, pos);
+}
+
+static int
+nouveau_bar2_diag_seq_show(struct seq_file *m, void *v)
+{
+	struct nouveau_bar2_diag_dump *dump = m->private;
+
+	if (v == SEQ_START_TOKEN) {
+		seq_printf(m,
+			   "NOUVEAU_DIAG_BAR2_RING capacity=%llu head=%llu captured=%llu dropped=%llu cutoff_ns=%llu\n",
+			   (unsigned long long)dump->capacity,
+			   (unsigned long long)dump->head,
+			   (unsigned long long)dump->captured,
+			   (unsigned long long)dump->dropped,
+			   (unsigned long long)dump->cutoff_ns);
+	} else if (v == &nouveau_bar2_diag_end_token) {
+		seq_printf(m,
+			   "NOUVEAU_DIAG_BAR2_RING_END head=%llu dropped=%llu\n",
+			   (unsigned long long)nvkm_bar2_diag_ring_head(),
+			   (unsigned long long)nvkm_bar2_diag_ring_dropped());
+	} else {
+		u64 mono_ns;
+		char message[512];
+
+		if (nvkm_bar2_diag_ring_read(dump->index, &mono_ns, message,
+					     sizeof(message)))
+			seq_printf(m,
+				   "NOUVEAU_DIAG_BAR2_RING_EVENT index=%llu mono_ns=%llu message=%s\n",
+				   (unsigned long long)dump->index,
+				   (unsigned long long)mono_ns, message);
+		else
+			seq_printf(m,
+				   "NOUVEAU_DIAG_BAR2_RING_GAP index=%llu\n",
+				   (unsigned long long)dump->index);
+	}
+	return 0;
+}
+
+static void
+nouveau_bar2_diag_seq_stop(struct seq_file *m, void *v)
+{
+}
+
+static const struct seq_operations nouveau_bar2_diag_seq_ops = {
+	.start = nouveau_bar2_diag_seq_start,
+	.next = nouveau_bar2_diag_seq_next,
+	.stop = nouveau_bar2_diag_seq_stop,
+	.show = nouveau_bar2_diag_seq_show,
+};
+
+static int
+nouveau_bar2_diag_open(struct inode *inode, struct file *file)
+{
+	return seq_open_private(file, &nouveau_bar2_diag_seq_ops,
+				sizeof(struct nouveau_bar2_diag_dump));
+}
+
+static const struct file_operations nouveau_bar2_diag_fops = {
+	.owner = THIS_MODULE,
+	.open = nouveau_bar2_diag_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = seq_release_private,
+};
+
+static int
+nouveau_bar2_diag_status_show(struct seq_file *m, void *data)
+{
+	u64 head_before = nvkm_bar2_diag_ring_head();
+	u64 dropped_before = nvkm_bar2_diag_ring_dropped();
+	u64 head_after = nvkm_bar2_diag_ring_head();
+	u64 dropped_after = nvkm_bar2_diag_ring_dropped();
+
+	seq_printf(m,
+		   "NOUVEAU_DIAG_BAR2_RING_STATUS enabled=%u capacity=%llu head_before=%llu head_after=%llu dropped_before=%llu dropped_after=%llu\n",
+		   nvkm_bar2_diag_enabled(),
+		   (unsigned long long)nvkm_bar2_diag_ring_capacity(),
+		   (unsigned long long)head_before,
+		   (unsigned long long)head_after,
+		   (unsigned long long)dropped_before,
+		   (unsigned long long)dropped_after);
+	return 0;
+}
+
+static int
+nouveau_bar2_diag_status_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, nouveau_bar2_diag_status_show,
+			   inode->i_private);
+}
+
+static const struct file_operations nouveau_bar2_diag_status_fops = {
+	.owner = THIS_MODULE,
+	.open = nouveau_bar2_diag_status_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+#endif
+
@@ -1141,0 +1289,6 @@
+	debugfs_create_file("ambient_bar2_events", 0400,
+			    minor->debugfs_root, minor->dev,
+			    &nouveau_bar2_diag_fops);
+	debugfs_create_file("ambient_bar2_status", 0400,
+			    minor->debugfs_root, minor->dev,
+			    &nouveau_bar2_diag_status_fops);

diff --git a/drivers/gpu/drm/nouveau/nouveau_drm.c b/drivers/gpu/drm/nouveau/nouveau_drm.c
index 0c23398..513ddfc 100644
--- a/drivers/gpu/drm/nouveau/nouveau_drm.c
+++ b/drivers/gpu/drm/nouveau/nouveau_drm.c
@@ -54,0 +55 @@
