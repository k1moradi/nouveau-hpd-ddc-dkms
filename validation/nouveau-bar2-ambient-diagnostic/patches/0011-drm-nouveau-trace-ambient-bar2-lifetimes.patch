+#if IS_ENABLED(CONFIG_DRM_NOUVEAU_SELFTEST)
+static bool nouveau_diag_bar2_map;
+module_param_named(diag_bar2_map, nouveau_diag_bar2_map, bool, 0600);
+MODULE_PARM_DESC(diag_bar2_map, "Log normal instmem BAR2 map lifetimes");
+
+static atomic64_t nv50_instobj_diag_id = ATOMIC64_INIT(0);
+static atomic64_t nv50_instobj_diag_attempt = ATOMIC64_INIT(0);
+
+struct nv50_instobj_diag_identity {
+	u64 id;
+	u64 mem_addr;
+	u64 mem_len;
+};
+
+static void
+nv50_instobj_diag_identity(struct nv50_instobj *iobj,
+			   struct nv50_instobj_diag_identity *identity)
+{
+	identity->id = iobj->diag_id;
+	identity->mem_addr = nvkm_memory_addr(iobj->ram);
+	identity->mem_len = nvkm_memory_size(iobj->ram);
+}
+
+static void
+nv50_instobj_diag_log(struct nvkm_subdev *subdev,
+		      const struct nv50_instobj_diag_identity *identity,
+		      const char *stage, u64 attempt, u64 bar2_va, u64 bar2_len,
+		      const char *range, const char *access, int refs, int rc)
+{
+	char message[384];
+	char comm[TASK_COMM_LEN];
+	size_t used = 0;
+	int i;
+
+	if (!READ_ONCE(nouveau_diag_bar2_map))
+		return;
+
+	get_task_comm(comm, current);
+	for (i = 0; i < TASK_COMM_LEN && comm[i]; i++) {
+		char c = comm[i];
+
+		if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+		      (c >= '0' && c <= '9') || c == '_' || c == '.' || c == '-'))
+			comm[i] = '_';
+	}
+
+	used += scnprintf(message + used, sizeof(message) - used,
+			  "NOUVEAU_DIAG_BAR2_MAP seq=%llu id=%llu stage=%s ",
+			  (unsigned long long)nvkm_bar2_diag_sequence(),
+			  (unsigned long long)identity->id, stage);
+	used += scnprintf(message + used, sizeof(message) - used,
+			  "attempt=%llu vmm=BAR2 mem_addr=%#llx ",
+			  (unsigned long long)attempt,
+			  (unsigned long long)identity->mem_addr);
+	used += scnprintf(message + used, sizeof(message) - used,
+			  "mem_len=%#llx bar2_va=%#llx ",
+			  (unsigned long long)identity->mem_len,
+			  (unsigned long long)bar2_va);
+	used += scnprintf(message + used, sizeof(message) - used,
+			  "bar2_len=%#llx range=%s access=%s ",
+			  (unsigned long long)bar2_len, range, access);
+	used += scnprintf(message + used, sizeof(message) - used,
+			  "refs=%d pid=%d comm=%s rc=%d", refs,
+			  task_pid_nr(current), comm, rc);
+	nvkm_info(subdev, "%s\n", message);
+}
+#endif
 
 static void
 nv50_instobj_wr32_slow(struct nvkm_memory *memory, u64 offset, u32 data)
 {
 	struct nv50_instobj *iobj = nv50_instobj(memory);
 	struct nv50_instmem *imem = iobj->imem;
 	struct nvkm_device *device = imem->base.subdev.device;
 	u64 base = (nvkm_memory_addr(iobj->ram) + offset) & 0xffffff00000ULL;
 	u64 addr = (nvkm_memory_addr(iobj->ram) + offset) & 0x000000fffffULL;
 	unsigned long flags;
 
 	spin_lock_irqsave(&imem->base.lock, flags);
 	if (unlikely(imem->addr != base)) {
 		imem->base.func->set_bar0_window_addr(device, base);
 		imem->addr = base;
 	}
 	nvkm_wr32(device, 0x700000 + addr, data);
 	spin_unlock_irqrestore(&imem->base.lock, flags);
 }
 
