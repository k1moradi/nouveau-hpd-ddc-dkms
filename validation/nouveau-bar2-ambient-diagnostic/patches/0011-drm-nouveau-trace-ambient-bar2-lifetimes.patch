index 874a508..7b9c7b9 100644
--- a/drivers/gpu/drm/nouveau/include/nvkm/subdev/bar.h
+++ b/drivers/gpu/drm/nouveau/include/nvkm/subdev/bar.h
@@ -22,10 +22,16 @@ struct nvkm_bar {
 struct nvkm_vmm *nvkm_bar_bar1_vmm(struct nvkm_device *);
 void nvkm_bar_bar1_reset(struct nvkm_device *);
 void nvkm_bar_bar2_init(struct nvkm_device *);
 void nvkm_bar_bar2_fini(struct nvkm_device *);
 void nvkm_bar_bar2_reset(struct nvkm_device *);
+#if IS_ENABLED(CONFIG_DRM_NOUVEAU_SELFTEST)
+bool nvkm_bar2_diag_enabled(void);
+u64 nvkm_bar2_diag_sequence(void);
+u64 nvkm_bar2_diag_reset_generation(void);
+u64 nvkm_bar2_diag_reset_begin(void);
+#endif
 struct nvkm_vmm *nvkm_bar_bar2_vmm(struct nvkm_device *);
 void nvkm_bar_flush(struct nvkm_bar *);
-
+
 int nv50_bar_new(struct nvkm_device *, enum nvkm_subdev_type, int inst, struct nvkm_bar **);
 int g84_bar_new(struct nvkm_device *, enum nvkm_subdev_type, int inst, struct nvkm_bar **);
diff --git a/drivers/gpu/drm/nouveau/nvkm/subdev/bar/base.c b/drivers/gpu/drm/nouveau/nvkm/subdev/bar/base.c
index 7dee55b..4e83069 100644
--- a/drivers/gpu/drm/nouveau/nvkm/subdev/bar/base.c
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/bar/base.c
@@ -21,10 +21,46 @@
  *
  * Authors: Ben Skeggs
  */
 #include "priv.h"
-
+
+#if IS_ENABLED(CONFIG_DRM_NOUVEAU_SELFTEST)
+#include <linux/atomic.h>
+#include <linux/moduleparam.h>
+
+static bool nvkm_diag_bar2_map;
+module_param_named(diag_bar2_map, nvkm_diag_bar2_map, bool, 0400);
+MODULE_PARM_DESC(diag_bar2_map, "Log ambient BAR2 instmem mappings");
+
+static atomic64_t nvkm_bar2_diag_seq = ATOMIC64_INIT(0);
+static atomic64_t nvkm_bar2_diag_gen = ATOMIC64_INIT(0);
+
+bool
+nvkm_bar2_diag_enabled(void)
+{
+	return READ_ONCE(nvkm_diag_bar2_map);
+}
+
+u64
+nvkm_bar2_diag_sequence(void)
+{
+	return atomic64_inc_return(&nvkm_bar2_diag_seq);
+}
+
+u64
+nvkm_bar2_diag_reset_generation(void)
+{
+	return atomic64_read(&nvkm_bar2_diag_gen);
+}
+
+u64
+nvkm_bar2_diag_reset_begin(void)
+{
+	return atomic64_inc_return(&nvkm_bar2_diag_gen);
+}
+#endif
+
 void
 nvkm_bar_flush(struct nvkm_bar *bar)
 {
 	if (bar && bar->func->flush)
 		bar->func->flush(bar);
@@ -61,12 +97,31 @@ nvkm_bar_bar2_vmm(struct nvkm_device *device)
 void
 nvkm_bar_bar2_reset(struct nvkm_device *device)
 {
 	struct nvkm_bar *bar = device->bar;
 	if (bar && bar->bar2) {
+#if IS_ENABLED(CONFIG_DRM_NOUVEAU_SELFTEST)
+		const bool diag = nvkm_bar2_diag_enabled();
+		u64 generation = 0;
+
+		if (diag) {
+			generation = nvkm_bar2_diag_reset_begin();
+			nvkm_info(&bar->subdev,
+				  "NOUVEAU_DIAG_BAR2_RESET seq=%llu gen=%llu stage=BEGIN\n",
+				  (unsigned long long)nvkm_bar2_diag_sequence(),
+				  (unsigned long long)generation);
+		}
+#endif
 		bar->func->bar2.init(bar);
 		bar->func->bar2.wait(bar);
+#if IS_ENABLED(CONFIG_DRM_NOUVEAU_SELFTEST)
+		if (diag)
+			nvkm_info(&bar->subdev,
+				  "NOUVEAU_DIAG_BAR2_RESET seq=%llu gen=%llu stage=END\n",
+				  (unsigned long long)nvkm_bar2_diag_sequence(),
+				  (unsigned long long)generation);
+#endif
 	}
 }
