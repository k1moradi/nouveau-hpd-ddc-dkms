+#endif
 		nvkm_vmm_put(vmm, &iobj->bar);
+#if IS_ENABLED(CONFIG_DRM_NOUVEAU_SELFTEST)
+		nv50_instobj_diag_log(subdev, &diag, "MAP_ROLLBACK_DONE",
+				      attempt, evict_va, evict_len,
+				      "released", "none", 0, -ENOMEM);
+#endif
+	} else {
+#if IS_ENABLED(CONFIG_DRM_NOUVEAU_SELFTEST)
+		nv50_instobj_diag_log(subdev, &diag, "MAP_READY", attempt,
+				      iobj->bar->addr, iobj->bar->size,
+				      "current", "none", 0, 0);
+#endif
 	}
 }
 
 static int
 nv50_instobj_map(struct nvkm_memory *memory, u64 offset, struct nvkm_vmm *vmm,
 		 struct nvkm_vma *vma, void *argv, u32 argc)
 {
 	memory = nv50_instobj(memory)->ram;
 	return nvkm_memory_map(memory, offset, vmm, vma, argv, argc);
 }
 
 static void
 nv50_instobj_release(struct nvkm_memory *memory)
 {
 	struct nv50_instobj *iobj = nv50_instobj(memory);
 	struct nv50_instmem *imem = iobj->imem;
 	struct nvkm_subdev *subdev = &imem->base.subdev;
 
 	wmb();
 	nvkm_bar_flush(subdev->device->bar);
 
 	if (refcount_dec_and_mutex_lock(&iobj->maps, &imem->base.mutex)) {
+#if IS_ENABLED(CONFIG_DRM_NOUVEAU_SELFTEST)
+		{
+			struct nv50_instobj_diag_identity diag;
+			const bool has_bar = !!iobj->bar;
+			const bool has_map = !!iobj->map;
+			const char *range = has_bar ? "cached" :
+				(has_map ? "unknown" : "none");
+
+			nv50_instobj_diag_identity(iobj, &diag);
+			nv50_instobj_diag_log(&imem->base.subdev, &diag,
+					      "LAST_MAP_RELEASE", 0,
+					      has_bar ? iobj->bar->addr : 0,
+					      has_bar ? iobj->bar->size : 0, range,
+					      "none", 0, 0);
+		}
+#endif
 		/* Add the now-unused mapping to the LRU instead of directly
 		 * unmapping it here, in case we need to map it again later.
 		 */
 		if (likely(iobj->lru.next) && iobj->map) {
 			BUG_ON(!list_empty(&iobj->lru));
 			list_add_tail(&iobj->lru, &imem->lru);
 		}
 
 		/* Switch back to NULL accessors when last map is gone. */
 		iobj->base.memory.ptrs = NULL;
 		mutex_unlock(&imem->base.mutex);
 	}
 }
 
 static void __iomem *
 nv50_instobj_acquire(struct nvkm_memory *memory)
 {
 	struct nv50_instobj *iobj = nv50_instobj(memory);
 	struct nvkm_instmem *imem = &iobj->imem->base;
 	struct nvkm_vmm *vmm;
@@ -239,62 +410,88 @@
 
