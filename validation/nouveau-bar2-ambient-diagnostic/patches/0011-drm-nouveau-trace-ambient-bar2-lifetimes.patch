+#if IS_ENABLED(CONFIG_DRM_NOUVEAU_SELFTEST)
+		const u64 rollback_va = bar ? bar->addr : 0;
+		const u64 rollback_len = bar ? bar->size : 0;
+
+		if (bar) {
+			const char *stage = ret ? "MAP_FAILED" : "MAP_DISCARDED";
+
+			nv50_instobj_diag_log(subdev, &diag, stage, attempt,
+					      bar->addr, bar->size, "reserved",
+					      "none", 0, ret);
+			nv50_instobj_diag_log(subdev, &diag, "MAP_ROLLBACK_BEGIN",
+					      attempt, bar->addr, bar->size,
+					      "reserved", "none", 0, ret);
+		} else {
+			nv50_instobj_diag_log(subdev, &diag, "MAP_FAILED", attempt,
