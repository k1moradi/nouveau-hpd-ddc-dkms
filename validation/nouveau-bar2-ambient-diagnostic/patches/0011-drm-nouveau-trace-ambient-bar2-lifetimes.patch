+static void
+nv50_instobj_diag_identity(struct nv50_instobj *iobj,
+			   struct nv50_instobj_diag_identity *identity)
+{
+	identity->id = iobj->diag_id;
+	identity->mem_addr = nvkm_memory_addr(iobj->ram);
+	identity->mem_len = nvkm_memory_size(iobj->ram);
+	identity->map_reset_gen = iobj->diag_map_reset_gen;
+	identity->map_reset_valid = iobj->diag_map_reset_valid;
+}
+
+static void
+nv50_instobj_diag_log(struct nvkm_subdev *subdev,
+		      const struct nv50_instobj_diag_identity *identity,
+		      const char *stage, u64 attempt, u64 bar2_va, u64 bar2_len,
+		      const char *vma_state, const char *cache_state,
+		      const char *access, const char *map_source, int refs, int rc)
+{
+	char message[512];
+	char comm[TASK_COMM_LEN];
+	size_t used = 0;
+	int i;
+
+	if (!nvkm_bar2_diag_enabled())
+		return;
+
+	get_task_comm(comm, current);
+	for (i = 0; i < TASK_COMM_LEN && comm[i]; i++) {
+		char c = comm[i];
+
+		if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+		      (c >= '0' && c <= '9') || c == '_' || c == '.' || c == '-'))
+			comm[i] = '_';
+	}
+	if (!comm[0])
+		strscpy(comm, "unknown", sizeof(comm));
+
+	used += scnprintf(message + used, sizeof(message) - used,
+			  "NOUVEAU_DIAG_BAR2_MAP seq=%llu id=%llu stage=%s ",
+			  (unsigned long long)nvkm_bar2_diag_sequence(),
+			  (unsigned long long)identity->id, stage);
+	used += scnprintf(message + used, sizeof(message) - used,
+			  "attempt=%llu vmm=BAR2 mem_addr=%#llx mem_len=%#llx ",
+			  (unsigned long long)attempt,
+			  (unsigned long long)identity->mem_addr,
+			  (unsigned long long)identity->mem_len);
+	used += scnprintf(message + used, sizeof(message) - used,
+			  "bar2_va=%#llx bar2_len=%#llx vma_state=%s ",
+			  (unsigned long long)bar2_va,
+			  (unsigned long long)bar2_len, vma_state);
+	used += scnprintf(message + used, sizeof(message) - used,
+			  "cache_state=%s access=%s map_source=%s ",
+			  cache_state, access, map_source);
+	if (identity->map_reset_valid)
+		used += scnprintf(message + used, sizeof(message) - used,
+				  "map_reset_gen=%llu ",
+				  (unsigned long long)identity->map_reset_gen);
+	else
+		used += scnprintf(message + used, sizeof(message) - used,
+				  "map_reset_gen=none ");
+	used += scnprintf(message + used, sizeof(message) - used,
+			  "current_reset_gen=%llu refs=%d pid=%d comm=%s rc=%d",
+			  (unsigned long long)nvkm_bar2_diag_reset_generation(),
+			  refs, task_pid_nr(current), comm, rc);
+	nvkm_info(subdev, "%s\n", message);
+}
+
+static const char *
+nv50_instobj_diag_vma_state(struct nv50_instobj *iobj)
+{
+	if (iobj->bar && iobj->map)
+		return "resident";
+	if (!iobj->bar && !iobj->map)
+		return "not_established";
+	return "unknown";
+}
+
+static const char *
+nv50_instobj_diag_cache_state(struct nv50_instobj *iobj)
+{
+	if (!iobj->bar || !iobj->map)
+		return "none";
+	if (!refcount_read(&iobj->maps))
+		return iobj->lru.next ? "lru" : "pinned";
+	return "active";
+}
