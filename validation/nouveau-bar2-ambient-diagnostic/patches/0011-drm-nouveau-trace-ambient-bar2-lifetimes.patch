+#if IS_ENABLED(CONFIG_DRM_NOUVEAU_SELFTEST)
 	if (ret == 0)
+		nv50_instobj_diag_log(subdev, &diag, "MAP_VMA_RESERVED", attempt,
+				      bar->addr, bar->size, "reserved", "none", 0, 0);
+#endif
+	if (ret == 0) {
 		ret = nvkm_memory_map(memory, 0, vmm, bar, NULL, 0);
+#if IS_ENABLED(CONFIG_DRM_NOUVEAU_SELFTEST)
+		if (!ret)
+			nv50_instobj_diag_log(subdev, &diag, "MAP_PTE_READY", attempt,
+					      bar->addr, bar->size, "reserved", "none", 0, 0);
+#endif
+	}
 	mutex_lock(&imem->base.mutex);
 	if (ret || iobj->bar) {
