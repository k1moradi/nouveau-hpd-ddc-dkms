+	u64 attempt = 0;
+	u64 evict_va, evict_len;
+
+	nv50_instobj_diag_identity(iobj, &diag);
+	if (READ_ONCE(nouveau_diag_bar2_map)) {
+		attempt = atomic64_inc_return(&nv50_instobj_diag_attempt);
+		nv50_instobj_diag_log(subdev, &diag, "MAP_BEGIN", attempt, 0, 0,
+				      "none", "none", refcount_read(&iobj->maps), 0);
+	}
+#endif
 
 	/* Attempt to allocate BAR2 address-space and map the object
 	 * into it.  The lock has to be dropped while doing this due
 	 * to the possibility of recursion for page table allocation.
 	 */
 	mutex_unlock(&imem->base.mutex);
 	while ((ret = nvkm_vmm_get(vmm, 12, size, &bar))) {
 		/* Evict unused mappings, and keep retrying until we either
 		 * succeed,or there's no more objects left on the LRU.
 		 */
 		mutex_lock(&imem->base.mutex);
 		eobj = list_first_entry_or_null(&imem->lru, typeof(*eobj), lru);
 		if (eobj) {
 			nvkm_debug(subdev, "evict %016llx %016llx @ %016llx\n",
 				   nvkm_memory_addr(&eobj->base.memory),
 				   nvkm_memory_size(&eobj->base.memory),
 				   eobj->bar->addr);
+#if IS_ENABLED(CONFIG_DRM_NOUVEAU_SELFTEST)
+			nv50_instobj_diag_identity(eobj, &ediag);
+			evict_va = eobj->bar->addr;
+			evict_len = eobj->bar->size;
+			nv50_instobj_diag_log(subdev, &ediag, "EVICTING", 0,
+					      evict_va, evict_len, "current", "none",
+					      refcount_read(&eobj->maps), 0);
+#endif
 			list_del_init(&eobj->lru);
 			ebar = eobj->bar;
 			eobj->bar = NULL;
 			emap = eobj->map;
 			eobj->map = NULL;
 		}
 		mutex_unlock(&imem->base.mutex);
 		if (!eobj)
 			break;
 		iounmap(emap);
 		nvkm_vmm_put(vmm, &ebar);
-	}
-
+#if IS_ENABLED(CONFIG_DRM_NOUVEAU_SELFTEST)
+		nv50_instobj_diag_log(subdev, &ediag, "EVICTED", 0,
