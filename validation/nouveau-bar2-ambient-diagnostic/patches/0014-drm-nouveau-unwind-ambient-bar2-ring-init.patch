diff --git a/drivers/gpu/drm/nouveau/nouveau_drm.c b/drivers/gpu/drm/nouveau/nouveau_drm.c
index 513ddfc..63d9c02 100644
--- a/drivers/gpu/drm/nouveau/nouveau_drm.c
+++ b/drivers/gpu/drm/nouveau/nouveau_drm.c
@@ -116,6 +116,10 @@ static struct drm_driver driver_stub;
 static struct drm_driver driver_pci;
 static struct drm_driver driver_platform;
 
+#ifdef CONFIG_NOUVEAU_PLATFORM_DRIVER
+static bool nouveau_platform_driver_registered;
+#endif
+
 #ifdef CONFIG_DEBUG_FS
 struct dentry *nouveau_debugfs_root;
 
@@ -1444,6 +1448,32 @@ err_free:
 	return ERR_PTR(err);
 }
 
+/* Quiesce every registered producer before freeing the module-global ring. */
+static void
+nouveau_drm_fini(void)
+{
+	nouveau_backlight_dtor();
+	nouveau_unregister_dsm_handler();
+
+#ifdef CONFIG_NOUVEAU_PLATFORM_DRIVER
+	if (nouveau_platform_driver_registered) {
+		platform_driver_unregister(&nouveau_platform_driver);
+		nouveau_platform_driver_registered = false;
+	}
+#endif
+	if (IS_ENABLED(CONFIG_DRM_NOUVEAU_SVM))
+		mmu_notifier_synchronize();
+
+#ifdef CONFIG_DEBUG_FS
+	nvif_log_shutdown(&gsp_logs);
+#endif
+
+	nouveau_module_debugfs_fini();
+#if IS_ENABLED(CONFIG_DRM_NOUVEAU_SELFTEST)
+	nvkm_bar2_diag_ring_fini();
+#endif
+}
+
 static int __init
 nouveau_drm_init(void)
 {
@@ -1471,7 +1501,8 @@ nouveau_drm_init(void)
 	nouveau_module_debugfs_init();
 
 #ifdef CONFIG_NOUVEAU_PLATFORM_DRIVER
-	platform_driver_register(&nouveau_platform_driver);
+	nouveau_platform_driver_registered =
+		platform_driver_register(&nouveau_platform_driver) == 0;
 #endif
 
 	nouveau_register_dsm_handler();
@@ -1480,10 +1511,7 @@ nouveau_drm_init(void)
 #ifdef CONFIG_PCI
 	ret = pci_register_driver(&nouveau_drm_pci_driver);
 	if (ret) {
-		nouveau_module_debugfs_fini();
-#if IS_ENABLED(CONFIG_DRM_NOUVEAU_SELFTEST)
-		nvkm_bar2_diag_ring_fini();
-#endif
+		nouveau_drm_fini();
 		return ret;
 	}
 #endif
@@ -1500,23 +1528,7 @@ nouveau_drm_exit(void)
 #ifdef CONFIG_PCI
 	pci_unregister_driver(&nouveau_drm_pci_driver);
 #endif
-	nouveau_backlight_dtor();
-	nouveau_unregister_dsm_handler();
-
-#ifdef CONFIG_NOUVEAU_PLATFORM_DRIVER
-	platform_driver_unregister(&nouveau_platform_driver);
-#endif
-	if (IS_ENABLED(CONFIG_DRM_NOUVEAU_SVM))
-		mmu_notifier_synchronize();
-
-#ifdef CONFIG_DEBUG_FS
-	nvif_log_shutdown(&gsp_logs);
-#endif
-
-	nouveau_module_debugfs_fini();
-#if IS_ENABLED(CONFIG_DRM_NOUVEAU_SELFTEST)
-	nvkm_bar2_diag_ring_fini();
-#endif
+	nouveau_drm_fini();
 }
 
 module_init(nouveau_drm_init);
