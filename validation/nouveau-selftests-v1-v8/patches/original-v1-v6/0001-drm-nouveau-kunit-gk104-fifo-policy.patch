diff --git a/drivers/gpu/drm/nouveau/nvkm/engine/fifo/kunit.c b/drivers/gpu/drm/nouveau/nvkm/engine/fifo/kunit.c
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/nouveau/nvkm/engine/fifo/kunit.c
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: MIT
+#include <kunit/test.h>
+
+#include "priv.h"
+
+static void
+gk104_legacy_video_context_is_nonpriv_test(struct kunit *test)
+{
+	KUNIT_EXPECT_FALSE(test, gk104_ectx_map_priv(NVKM_ENGINE_MSPDEC));
+	KUNIT_EXPECT_FALSE(test, gk104_ectx_map_priv(NVKM_ENGINE_MSPPP));
+	KUNIT_EXPECT_FALSE(test, gk104_ectx_map_priv(NVKM_ENGINE_MSVLD));
+}
+
+static void
+gk104_other_contexts_remain_priv_test(struct kunit *test)
+{
+	KUNIT_EXPECT_TRUE(test, gk104_ectx_map_priv(NVKM_ENGINE_GR));
+	KUNIT_EXPECT_TRUE(test, gk104_ectx_map_priv(NVKM_ENGINE_CE));
+	KUNIT_EXPECT_TRUE(test, gk104_ectx_map_priv(NVKM_ENGINE_SW));
+}
+
+static void
+nvkm_legacy_nonstall_uses_global_event_test(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, nvkm_uchan_nonstall_event_index(false, 0), 0);
+	KUNIT_EXPECT_EQ(test, nvkm_uchan_nonstall_event_index(false, 1), 0);
+	KUNIT_EXPECT_EQ(test, nvkm_uchan_nonstall_event_index(false, 7), 0);
+}
+
+static void
+nvkm_per_runlist_nonstall_uses_runlist_event_test(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, nvkm_uchan_nonstall_event_index(true, 0), 0);
+	KUNIT_EXPECT_EQ(test, nvkm_uchan_nonstall_event_index(true, 1), 1);
+	KUNIT_EXPECT_EQ(test, nvkm_uchan_nonstall_event_index(true, 7), 7);
+}
+
+static struct kunit_case nouveau_fifo_policy_test_cases[] = {
+	KUNIT_CASE(gk104_legacy_video_context_is_nonpriv_test),
+	KUNIT_CASE(gk104_other_contexts_remain_priv_test),
+	KUNIT_CASE(nvkm_legacy_nonstall_uses_global_event_test),
+	KUNIT_CASE(nvkm_per_runlist_nonstall_uses_runlist_event_test),
+	{}
+};
+
+static struct kunit_suite nouveau_fifo_policy_test_suite = {
+	.name = "nouveau-fifo-policy",
+	.test_cases = nouveau_fifo_policy_test_cases,
+};
+
+kunit_test_suite(nouveau_fifo_policy_test_suite);
+
+MODULE_DESCRIPTION("KUnit tests for Nouveau FIFO policy");
+MODULE_LICENSE("GPL");
diff --git a/drivers/gpu/drm/nouveau/nvkm/engine/fifo/priv.h b/drivers/gpu/drm/nouveau/nvkm/engine/fifo/priv.h
--- a/drivers/gpu/drm/nouveau/nvkm/engine/fifo/priv.h
+++ b/drivers/gpu/drm/nouveau/nvkm/engine/fifo/priv.h
@@ -4,6 +4,29 @@
 	} chan;
 };
 
+
+static inline bool
+gk104_ectx_map_priv(enum nvkm_subdev_type type)
+{
+	switch (type) {
+	case NVKM_ENGINE_MSPDEC:
+	case NVKM_ENGINE_MSPPP:
+	case NVKM_ENGINE_MSVLD:
+		return false;
+	default:
+		return true;
+	}
+}
+
+static inline int
+nvkm_uchan_nonstall_event_index(bool per_runlist, int runlist_id)
+{
+	if (per_runlist)
+		return runlist_id;
+
+	return 0;
+}
