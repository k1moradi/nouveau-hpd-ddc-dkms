diff --git a/drivers/gpu/drm/nouveau/Kconfig b/drivers/gpu/drm/nouveau/Kconfig
--- a/drivers/gpu/drm/nouveau/Kconfig
+++ b/drivers/gpu/drm/nouveau/Kconfig
@@ -17,6 +17,20 @@ config DRM_NOUVEAU_KUNIT_TEST
 
 	  These tests do not submit GPU work or access MMIO.
 
+config DRM_NOUVEAU_SELFTEST
+	bool "Nouveau safe live hardware selftests"
+	depends on DRM_NOUVEAU && DEBUG_FS
+	default n
+	help
+	  Build explicitly-triggered, low-risk live hardware checks exposed
+	  through debugfs.  The safe suite validates cached device identity
+	  and runlist/engine inventory and exercises the existing device-time
+	  query while holding a normal runtime-PM reference.
+
+	  Reading the selftest_safe debugfs file runs the suite.  It does not
+	  submit channels, write MMIO, access scratch BAR memory, or issue
+	  firmware commands.
+
 config NOUVEAU_PLATFORM_DRIVER
 	bool "Nouveau (NVIDIA) SoC GPUs"
 	depends on DRM_NOUVEAU && ARCH_TEGRA
diff --git a/drivers/gpu/drm/nouveau/nouveau_debugfs.c b/drivers/gpu/drm/nouveau/nouveau_debugfs.c
--- a/drivers/gpu/drm/nouveau/nouveau_debugfs.c
+++ b/drivers/gpu/drm/nouveau/nouveau_debugfs.c
@@ -1,5 +1,7 @@
 #include <linux/debugfs.h>
+#include <linux/delay.h>
 #include <nvif/class.h>
+#include <nvif/device.h>
 #include <nvif/if0001.h>
 #include "nouveau_debugfs.h"
 #include "nouveau_drv.h"
@@ -29,6 +31,164 @@ nouveau_debugfs_gpuva(struct seq_file *m, void *data)
 	return 0;
 }
 
+#if IS_ENABLED(CONFIG_DRM_NOUVEAU_SELFTEST)
+static int
+nouveau_debugfs_selftest_safe_show(struct seq_file *m, void *data)
+{
+	struct drm_device *dev = m->private;
+	struct nouveau_drm *drm = nouveau_drm(dev);
+	struct nvif_device *device = &drm->client.device;
+	const struct nv_device_info_v0 *info = &device->info;
+	const u64 gk104_required_engines =
+		NV_DEVICE_HOST_RUNLIST_ENGINES_GR |
+		NV_DEVICE_HOST_RUNLIST_ENGINES_MSVLD |
+		NV_DEVICE_HOST_RUNLIST_ENGINES_MSPDEC |
+		NV_DEVICE_HOST_RUNLIST_ENGINES_MSPPP;
+	struct nv_device_time_v0 time_args = {};
+	u64 engines = 0;
+	u64 time_before, time_after;
+	int failures = 0;
+	int ret;
+	int i;
+
+	if (info->chipset && info->family) {
+		seq_printf(m,
+			   "NOUVEAU_SELFTEST suite=safe test=device_info result=PASS "
+			   "platform=%u chipset=0x%04x revision=0x%02x family=%u "
+			   "chip=\"%s\" name=\"%s\"\n",
+			   info->platform, info->chipset, info->revision, info->family,
+			   info->chip, info->name);
+	} else {
+		failures++;
+		seq_printf(m,
+			   "NOUVEAU_SELFTEST suite=safe test=device_info result=FAIL "
+			   "platform=%u chipset=0x%04x revision=0x%02x family=%u\n",
+			   info->platform, info->chipset, info->revision, info->family);
+	}
+
+	if (device->runlists <= 0 || !device->runlist) {
+		failures++;
+		seq_printf(m,
+			   "NOUVEAU_SELFTEST suite=safe test=runlist_inventory "
+			   "result=FAIL count=%d reason=missing_runlist_metadata\n",
+			   device->runlists);
+	} else {
+		for (i = 0; i < device->runlists; i++) {
+			const u64 runlist_engines = device->runlist[i].engines;
+
+			engines |= runlist_engines;
+			seq_printf(m,
+				   "NOUVEAU_SELFTEST suite=safe test=runlist "
+				   "result=%s index=%d engines=0x%016llx%s\n",
+				   runlist_engines ? "PASS" : "SKIP", i,
+				   (unsigned long long)runlist_engines,
+				   runlist_engines ? "" : " reason=unused_index");
+		}
+
+		if (!engines)
+			failures++;
+		seq_printf(m,
+			   "NOUVEAU_SELFTEST suite=safe test=runlist_inventory "
+			   "result=%s count=%d engines=0x%016llx\n",
+			   engines ? "PASS" : "FAIL", device->runlists,
+			   (unsigned long long)engines);
+	}
+
+	if (info->family == NV_DEVICE_INFO_V0_KEPLER && info->chipset == 0x00e4) {
+		const u64 missing = gk104_required_engines & ~engines;
+		const bool pass = !missing && info->platform == NV_DEVICE_INFO_V0_PCIE;
+
+		if (!pass)
+			failures++;
+		seq_printf(m,
+			   "NOUVEAU_SELFTEST suite=safe test=gk104_nve4_profile "
+			   "result=%s platform=%u required=0x%016llx "
+			   "present=0x%016llx missing=0x%016llx\n",
+			   pass ? "PASS" : "FAIL", info->platform,
+			   (unsigned long long)gk104_required_engines,
+			   (unsigned long long)engines,
+			   (unsigned long long)missing);
+	} else {
+		seq_printf(m,
+			   "NOUVEAU_SELFTEST suite=safe test=gk104_nve4_profile "
+			   "result=SKIP family=%u chipset=0x%04x reason=not_gk104_nve4\n",
+			   info->family, info->chipset);
+	}
+
+	ret = pm_runtime_get_sync(drm->dev->dev);
+	if (ret < 0 && ret != -EACCES) {
+		failures++;
+		pm_runtime_put_autosuspend(drm->dev->dev);
+		seq_printf(m,
+			   "NOUVEAU_SELFTEST suite=safe test=device_time "
+			   "result=FAIL stage=runtime_pm errno=%d\n", ret);
+		goto done;
+	}
+
+	ret = nvif_object_mthd(&device->object, NV_DEVICE_V0_TIME,
+			       &time_args, sizeof(time_args));
+	if (ret) {
+		failures++;
+		seq_printf(m,
+			   "NOUVEAU_SELFTEST suite=safe test=device_time "
+			   "result=FAIL stage=first_query errno=%d\n", ret);
+		goto put_runtime_pm;
+	}
+	time_before = time_args.time;
+	usleep_range(1000, 2000);
+
+	time_args = (struct nv_device_time_v0){};
+	ret = nvif_object_mthd(&device->object, NV_DEVICE_V0_TIME,
+			       &time_args, sizeof(time_args));
+	if (ret) {
+		failures++;
+		seq_printf(m,
+			   "NOUVEAU_SELFTEST suite=safe test=device_time "
+			   "result=FAIL stage=second_query errno=%d\n", ret);
+		goto put_runtime_pm;
+	}
+	time_after = time_args.time;
+	if (time_after <= time_before) {
+		failures++;
+		seq_printf(m,
+			   "NOUVEAU_SELFTEST suite=safe test=device_time result=FAIL "
+			   "before=%llu after=%llu reason=time_did_not_advance\n",
+			   (unsigned long long)time_before,
+			   (unsigned long long)time_after);
+	} else {
+		seq_printf(m,
+			   "NOUVEAU_SELFTEST suite=safe test=device_time result=PASS "
+			   "before=%llu after=%llu delta=%llu\n",
+			   (unsigned long long)time_before,
+			   (unsigned long long)time_after,
+			   (unsigned long long)(time_after - time_before));
+	}
+
+put_runtime_pm:
+	pm_runtime_mark_last_busy(drm->dev->dev);
+	pm_runtime_put_autosuspend(drm->dev->dev);
+
+done:
+	seq_printf(m, "NOUVEAU_SELFTEST suite=safe result=%s failures=%d\n",
+		   failures ? "FAIL" : "PASS", failures);
+	return 0;
+}
+
+static int
+nouveau_debugfs_selftest_safe_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, nouveau_debugfs_selftest_safe_show, inode->i_private);
+}
+
+static const struct file_operations nouveau_selftest_safe_fops = {
+	.owner = THIS_MODULE,
+	.open = nouveau_debugfs_selftest_safe_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+#endif
+
 static const struct file_operations nouveau_pstate_fops = {
 	.owner = THIS_MODULE,
 	.open = nouveau_debugfs_pstate_open,
@@ -69,6 +229,11 @@ nouveau_drm_debugfs_init(struct drm_minor *minor)
 				 NOUVEAU_DEBUGFS_ENTRIES,
 				 minor->debugfs_root, minor);
 
+#if IS_ENABLED(CONFIG_DRM_NOUVEAU_SELFTEST)
+	debugfs_create_file("selftest_safe", S_IRUSR, minor->debugfs_root,
+			    minor->dev, &nouveau_selftest_safe_fops);
+#endif
+
 	/* Set the size of the vbios since we know it, and it's confusing to
 	 * userspace if it wants to seek() but the file has a length of 0
 	 */
