 	debugfs_create_file("selftest_instmem_32k", S_IRUSR, minor->debugfs_root,
 			    minor->dev, &nouveau_selftest_instmem_32k_fops);
+	debugfs_create_file("selftest_fifo_fence", S_IRUSR, minor->debugfs_root,
+			    minor->dev, &nouveau_selftest_fifo_fops);
