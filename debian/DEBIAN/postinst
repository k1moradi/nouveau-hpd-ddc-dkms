#!/bin/bash
set -e
NAME=nouveau-hpd-ddc
VER=0.1.5
rm -f /etc/modprobe.d/99-nouveau-i2c-test.conf
rm -f /etc/dracut.conf.d/61-nouveau-i2c-test.conf
if ! dkms status -m "$NAME" -v "$VER" 2>/dev/null | grep -q .; then
    dkms add -m "$NAME" -v "$VER"
fi
# Build for running kernel when headers are available. Future kernels are
# handled by DKMS AUTOINSTALL.
k=$(uname -r)
if [ -d "/lib/modules/$k/build" ]; then
    dkms install -m "$NAME" -v "$VER" -k "$k" --force
fi
exit 0
