#!/bin/bash
set -e
NAME=nouveau-hpd-ddc
VER=0.1.14
rm -f /etc/modprobe.d/99-nouveau-i2c-test.conf
rm -f /etc/dracut.conf.d/61-nouveau-i2c-test.conf

find /tmp -maxdepth 1 -type d \
    \( -name 'nouveau-hpd-ddc.*' -o -name 'nouveau-hpd-test-*' \) \
    -exec rm -rf -- {} + 2>/dev/null || true

if ! dkms status -m "$NAME" -v "$VER" 2>/dev/null | grep -q .; then
    dkms add -m "$NAME" -v "$VER"
fi
# Build for running kernel when headers are available. Future kernels are
# handled by DKMS AUTOINSTALL.
k=$(uname -r)
if [ -d "/lib/modules/$k/build" ]; then
    dkms build -m "$NAME" -v "$VER" -k "$k" --force
    # Keep the previous version through compilation, then clear DKMS's shared
    # module destination before installing the replacement.
    for oldver in 0.1.0 0.1.1 0.1.2 0.1.3 0.1.4 0.1.5 0.1.6 0.1.13; do
        if dkms status -m "$NAME" -v "$oldver" 2>/dev/null | grep -q .; then
            dkms remove -m "$NAME" -v "$oldver" --all
        fi
        rm -rf "/usr/src/$NAME-$oldver" "/var/lib/dkms/$NAME/$oldver"
    done
    dkms install -m "$NAME" -v "$VER" -k "$k" --force
    if ! dkms status -m "$NAME" -v "$VER" -k "$k" 2>/dev/null | grep -q 'installed'; then
        echo "ERROR: DKMS does not report $NAME/$VER installed for $k" >&2
        exit 2
    fi
else
    echo "DKMS source registered; preserving older installed revision because $k has no build tree."
fi
for modules_dir in /lib/modules/*; do
    [ -d "$modules_dir" ] || continue
    depmod -a "${modules_dir##*/}"
done
if [ -d "/lib/modules/$k/build" ]; then
    "/usr/src/$NAME-$VER/refresh-initramfs.sh" others
fi
exit 0
