From: Nouveau diagnostic preparation
Subject: [DIAGNOSTIC] drm/nouveau: trace idle fences and GK104 ctxsw engines

This opt-in diagnostic records channel-idle fence emission/progress and the
engine/context IDs used by the GF100/GK104 CTXSW_TIMEOUT recovery path. It does
not change fence packets, timeout values, scheduling, or recovery behavior.

Enable the separate Nouveau module parameters diag_fence_wait=1 and
diag_ctxsw=1 for one capture, then disable them after the run. The NVKM
CTXSW records are emitted only for the rare timeout path.

---
--- a/drivers/gpu/drm/nouveau/nouveau_chan.c
+++ b/drivers/gpu/drm/nouveau/nouveau_chan.c
@@ -70,7 +70,18 @@
 		struct nouveau_fence *fence = NULL;
 		int ret;
 
-		ret = nouveau_fence_new(&fence, chan);
+		if (unlikely(READ_ONCE(nouveau_diag_fence_wait))) {
+			ret = nouveau_fence_create(&fence, chan);
+			if (!ret) {
+				/* Mark before emit so diagnostics identify this idle fence. */
+				fence->idle = true;
+				ret = nouveau_fence_emit(fence);
+				if (ret)
+					nouveau_fence_unref(&fence);
+			}
+		} else {
+			ret = nouveau_fence_new(&fence, chan);
+		}
 		if (!ret) {
 			ret = nouveau_fence_wait(fence, false, false);
 			nouveau_fence_unref(&fence);
--- a/drivers/gpu/drm/nouveau/nouveau_fence.c
+++ b/drivers/gpu/drm/nouveau/nouveau_fence.c
@@ -27,6 +27,7 @@
 #include <linux/ktime.h>
 #include <linux/hrtimer.h>
 #include <linux/sched/signal.h>
+#include <linux/moduleparam.h>
 #include <trace/events/dma_fence.h>
 
 #include <nvif/if0020.h>
@@ -34,6 +35,11 @@
 #include "nouveau_drv.h"
 #include "nouveau_dma.h"
 #include "nouveau_fence.h"
+
+bool nouveau_diag_fence_wait;
+module_param_named(diag_fence_wait, nouveau_diag_fence_wait, bool, 0600);
+MODULE_PARM_DESC(diag_fence_wait,
+		 "Enable opt-in Nouveau channel-idle fence diagnostics");
 
 static const struct dma_fence_ops nouveau_fence_ops_uevent;
 static const struct dma_fence_ops nouveau_fence_ops_legacy;
@@ -297,9 +303,48 @@
 static int
 nouveau_fence_wait_busy(struct nouveau_fence *fence, bool intr)
 {
+	struct nouveau_channel *chan = fence->channel;
+	struct nouveau_fence_chan *fctx = nouveau_fctx(fence);
+	unsigned long start = 0, next_diag = 0;
+	bool diag = fence->idle && READ_ONCE(nouveau_diag_fence_wait);
 	int ret = 0;
 
+	if (diag) {
+		u32 value;
+
+		start = jiffies;
+		next_diag = start + HZ;
+		value = fctx->read ? fctx->read(chan) : ~0U;
+
+		dev_info(chan->cli->drm->nvkm->dev,
+			 "NOUVEAU_DIAG_IDLE_FENCE stage=wait-begin "
+			 "client=%s runlist=%d chid=%d seq=%llu gpu_addr=0x%016llx "
+			 "value_before=0x%08x value_now=0x%08x emit_ret=%d "
+			 "dma_put=%d dma_cur=%d dma_free=%d\n",
+			 chan->cli->name, chan->runlist, chan->chid,
+			 (unsigned long long)fence->base.seqno,
+			 (unsigned long long)fence->gpu_addr, fence->value_before,
+			 value, fence->emit_ret, chan->dma.put, chan->dma.cur,
+			 chan->dma.free);
+	}
+
 	while (!nouveau_fence_done(fence)) {
+		if (diag && time_after_eq(jiffies, next_diag)) {
+			u32 value = fctx->read ? fctx->read(chan) : ~0U;
+
+			dev_info(chan->cli->drm->nvkm->dev,
+				 "NOUVEAU_DIAG_IDLE_FENCE stage=wait-progress "
+				 "client=%s runlist=%d chid=%d seq=%llu "
+				 "gpu_addr=0x%016llx value_now=0x%08x "
+				 "elapsed_jiffies=%lu dma_put=%d dma_cur=%d dma_free=%d\n",
+				 chan->cli->name, chan->runlist, chan->chid,
+				 (unsigned long long)fence->base.seqno,
+				 (unsigned long long)fence->gpu_addr, value,
+				 jiffies - start, chan->dma.put, chan->dma.cur,
+				 chan->dma.free);
+			next_diag = jiffies + HZ;
+		}
+
 		if (time_after_eq(jiffies, fence->timeout)) {
 			ret = -EBUSY;
 			break;
@@ -316,6 +361,20 @@
 	}
 
 	__set_current_state(TASK_RUNNING);
+	if (diag) {
+		u32 value = fctx->read ? fctx->read(chan) : ~0U;
+
+		dev_info(chan->cli->drm->nvkm->dev,
+			 "NOUVEAU_DIAG_IDLE_FENCE stage=wait-end "
+			 "client=%s runlist=%d chid=%d seq=%llu "
+			 "gpu_addr=0x%016llx value_now=0x%08x result=%d "
+			 "elapsed_jiffies=%lu dma_put=%d dma_cur=%d dma_free=%d\n",
+			 chan->cli->name, chan->runlist, chan->chid,
+			 (unsigned long long)fence->base.seqno,
+			 (unsigned long long)fence->gpu_addr, value, ret,
+			 jiffies - start, chan->dma.put, chan->dma.cur,
+			 chan->dma.free);
+	}
 	return ret;
 }
 
--- a/drivers/gpu/drm/nouveau/nouveau_fence.h
+++ b/drivers/gpu/drm/nouveau/nouveau_fence.h
@@ -15,6 +15,11 @@
 
 	struct nouveau_channel __rcu *channel;
 	unsigned long timeout;
