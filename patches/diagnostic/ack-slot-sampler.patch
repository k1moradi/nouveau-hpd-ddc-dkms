+static int
+gf119_i2c_bus_sample_ack(struct nvkm_i2c_bus *base, u32 samples[3])
+{
+	struct gf119_i2c_bus *bus = gf119_i2c_bus(base);
+	struct nvkm_device *device = bus->base.pad->i2c->subdev.device;
+	int i;
+
+	if (bus->addr != 0x00d014)
+		return 0;
+
+	for (i = 0; i < 3; i++)
+		samples[i] = nvkm_rd32(device, bus->addr);
+
+	return 1;
+}
