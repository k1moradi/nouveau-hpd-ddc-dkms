+		  "DDC_DIAG: PNVIO_HW_DDC phase=result ret=%d bytes=%u chunks=%u status=%08x d014_restored=%08x\n",
+		  ret, bytes, chunks, status, nvkm_rd32(device, bus->addr));
+	return ret;
+}
