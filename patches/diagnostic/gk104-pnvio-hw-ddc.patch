+/*
+ * The GK104/K4200 GOP uses the PNVIO controller for the 400 kHz selector.
+ * Keep this backend restricted to the exact EDID block-0 probe/read shapes;
+ * see docs/GK104-PNVIO-HW-I2C-TRANSCRIPT.md in the DKMS project.
+ */
+static bool
+gf119_i2c_bus_hw_capable(struct nvkm_i2c_bus *base)
+{
+	struct gf119_i2c_bus *bus = gf119_i2c_bus(base);
+	struct nvkm_device *device = bus->base.pad->i2c->subdev.device;
+
+	return device->chipset == 0xe4 && bus->addr == 0x00d014 &&
+	       base->speed_sel == 3;
+}
+
+static bool
+gf119_i2c_bus_hw_xfer_eligible(struct nvkm_i2c_bus *base,
+			       struct i2c_msg *msgs, int num)
+{
+	if (!gf119_i2c_bus_hw_capable(base) || !msgs || num != 2)
+		return false;
+
+	/* DRM's EDID presence probe or block-0 read; no other shape is admitted. */
+	return msgs[0].addr == 0x50 && msgs[0].flags == 0 &&
+	       msgs[0].len == 1 && msgs[0].buf && msgs[0].buf[0] == 0 &&
+	       msgs[1].addr == 0x50 && msgs[1].flags == I2C_M_RD &&
+	       (msgs[1].len == 1 || msgs[1].len == 128) && msgs[1].buf;
+}
+
+static int
+gf119_i2c_hw_wait(struct nvkm_device *device, u32 reg, u32 *status)
+{
+	ktime_t start = ktime_get();
+
+	for (;;) {
+		*status = nvkm_rd32(device, reg);
+		if (!(*status & BIT(31)))
+			return ((*status >> 29) & 0x3) ? -EIO : 0;
+
+		/* GOP polls busy without sleeping for 0x9c4 timer units. */
+		if (ktime_us_delta(ktime_get(), start) >= 2500)
+			return -ETIMEDOUT;
+		cpu_relax();
+	}
+}
+
+struct gf119_i2c_hw_attempt {
+	int ret;
+	u32 bytes;
+	u32 chunks;
+	const char *failure_stage;
+	u32 d000_before;
+	int pre_idle_ret;
+	u32 pre_idle_status;
+	u32 d004;
+	u32 command;
+	u32 command_status;
+	int final_wait_ret;
+	u32 final_status;
+};
+
+static int
+gf119_i2c_hw_read_attempt(struct gf119_i2c_bus *bus,
+			  struct i2c_msg *msgs, int num,
+			  struct gf119_i2c_hw_attempt *attempt)
+{
+	struct nvkm_device *device = bus->base.pad->i2c->subdev.device;
+	const u32 d000 = bus->addr - 0x14;
+	const u32 d004 = bus->addr - 0x10;
+	const u32 d00c = bus->addr - 0x08;
+	const u32 length = msgs[1].len;
+	u32 accumulator = 1;
+	int ret = 0;
+
+	memset(attempt, 0, sizeof(*attempt));
+	attempt->failure_stage = "none";
+	attempt->d000_before = nvkm_rd32(device, d000);
+
+	/*
+	 * The GOP's first waiter is observational: its return is ignored.
+	 * D004 and the first read command still follow.
+	 */
+	attempt->pre_idle_ret =
+		gf119_i2c_hw_wait(device, d000, &attempt->pre_idle_status);
+
+	attempt->d004 = 0x00000050;
+	nvkm_wr32(device, d004, attempt->d004);
+
+	while (attempt->bytes < length) {
+		u32 count = min_t(u32, 4, length - attempt->bytes);
+		u32 command;
+		u32 word;
+		u32 i;
+
+		command = ((count << 6) ^ accumulator) & 0x003fffc0;
+		accumulator ^= command;
+		command = 0x80000014 | accumulator;
+		if (attempt->bytes + count == length)
+			command |= 0x10000002;
+
+		attempt->command = command;
+		nvkm_wr32(device, d000, command);
+		ret = gf119_i2c_hw_wait(device, d000,
+					&attempt->command_status);
+		if (ret) {
+			attempt->failure_stage = "read-command";
+			break;
+		}
+
+		word = nvkm_rd32(device, d00c);
+		for (i = 0; i < count; i++)
+			msgs[1].buf[attempt->bytes + i] =
+				(word >> (i * 8)) & 0xff;
+
+		attempt->bytes += count;
+		attempt->chunks++;
+	}
+
+	/* The GOP ignores this final wait result, then emits its STOP. */
+	attempt->final_wait_ret =
+		gf119_i2c_hw_wait(device, d000, &attempt->final_status);
+	nvkm_wr32(device, d000, 0x8000000c);
+
+	attempt->ret = ret ? ret : num;
+	return attempt->ret;
+}
+
+static void
+gf119_i2c_hw_recovery_drive_scl(struct gf119_i2c_bus *bus, int state)
+{
+	/* GOP line setters delay one period before each D014 update. */
+	udelay(1);
+	bus->base.func->drive_scl(&bus->base, state);
+}
+
+static void
+gf119_i2c_hw_recovery_drive_sda(struct gf119_i2c_bus *bus, int state)
+{
+	udelay(1);
+	bus->base.func->drive_sda(&bus->base, state);
+}
+
+static int
+gf119_i2c_hw_recovery_sequence(struct gf119_i2c_bus *bus)
+{
+	int i;
+
+	/* GOP routine at RVA 0x11588. */
+	gf119_i2c_hw_recovery_drive_sda(bus, 0);
+	gf119_i2c_hw_recovery_drive_scl(bus, 0);
+	gf119_i2c_hw_recovery_drive_scl(bus, 1);
+
+	/* RVA 0x11040 polls SCL at most six times, one period per poll. */
+	for (i = 0; i < 6; i++) {
+		udelay(1);
+		if (bus->base.func->sense_scl(&bus->base))
+			break;
+	}
+	if (i == 6)
+		return -ETIMEDOUT;
+
+	gf119_i2c_hw_recovery_drive_sda(bus, 1);
+	udelay(2);
+	gf119_i2c_hw_recovery_drive_sda(bus, 0);
+	gf119_i2c_hw_recovery_drive_scl(bus, 0);
+	return 0;
+}
+
+static bool
+gf119_i2c_hw_recover(struct gf119_i2c_bus *bus, u32 *cycles)
+{
+	struct nvkm_device *device = bus->base.pad->i2c->subdev.device;
+	u32 d014 = nvkm_rd32(device, bus->addr);
+	u32 lines;
+	int i;
+
+	/*
+	 * GOP method 0x11dc0 enters software line mode by copying the sensed
+	 * SCL/SDA levels into D014 output bits 0/1, preserving other bits.
+	 */
+	lines = ((d014 >> 4) & 0x1) | (((d014 >> 5) & 0x1) << 1);
+	nvkm_mask(device, bus->addr, 0x00000003, lines);
+
+	/* The dispatcher waits 10 us, then begins its bounded SCL recovery. */
+	udelay(10);
+	gf119_i2c_hw_recovery_drive_scl(bus, 0);
+
+	for (i = 0; i < 16; i++) {
+		bool sda;
+
+		gf119_i2c_hw_recovery_drive_scl(bus, 1);
+		udelay(10);
+
+		/* GOP sense helper waits one period before reading SDA_IN. */
+		udelay(1);
+		sda = bus->base.func->sense_sda(&bus->base);
+
+		/*
+		 * The GOP invokes its recovery line sequence on every cycle,
+		 * including the cycle that first observes SDA high.
+		 */
+		gf119_i2c_hw_recovery_sequence(bus);
+		*cycles = i + 1;
+		if (sda)
+			return true;
+	}
+
+	return false;
+}
+
+static int
+gf119_i2c_bus_hw_xfer(struct nvkm_i2c_bus *base,
+		      struct i2c_msg *msgs, int num)
+{
+	struct gf119_i2c_bus *bus = gf119_i2c_bus(base);
+	struct nvkm_device *device = bus->base.pad->i2c->subdev.device;
+	struct nvkm_subdev *subdev = &bus->base.pad->i2c->subdev;
+	const u32 d000 = bus->addr - 0x14;
+	const u32 d008 = bus->addr - 0x0c;
+	const u32 d010 = bus->addr - 0x04;
+	struct gf119_i2c_hw_attempt first;
+	struct gf119_i2c_hw_attempt second;
+	u32 saved_d014 = nvkm_rd32(device, bus->addr);
+	u32 d000_before;
+	u32 d008_before_speed;
+	u32 d008_after_speed;
+	u32 d008_after_init;
+	u32 init_wait_status = 0;
+	u32 speed_wait_status = 0;
+	u32 first_rate = bus->hw_speed ? bus->hw_speed : 400000;
+	u32 retry_speed_status = 0;
+	u32 caller_recovery_cycles = 0;
+	u32 retry_recovery_cycles = 0;
+	u32 retry_d008_before = 0;
+	u32 retry_d008_after = 0;
+	int init_wait_ret;
+	int speed_wait_ret;
+	int retry_speed_wait_ret = 0;
+	int first_ret = -EOPNOTSUPP;
+	int second_ret = -EOPNOTSUPP;
+	u32 result_bytes = 0;
+	u32 result_chunks = 0;
+	bool primary_attempted = false;
+	bool caller_recovered;
+	bool retry100_attempted = false;
+	bool retry_recovered = false;
+	const char *failure_stage = "caller-recovery";
+	int ret;
+
+	/*
+	 * This is a read-only preflight. Returning -EOPNOTSUPP lets the
+	 * dispatcher release the bus before entering Linux bitbang.
+	 */
+	if ((saved_d014 & 0x7) != 0x7) {
+		nvkm_info(subdev,
+			  "DDC_DIAG: PNVIO_HW_DDC phase=preflight result=unsupported d014=%08x selector=%u\n",
+			  saved_d014, base->speed_sel);
+		return -EOPNOTSUPP;
+	}
+
+	d000_before = nvkm_rd32(device, d000);
+	nvkm_info(subdev,
+		  "DDC_DIAG: PNVIO_HW_DDC phase=start bus=d014 selector=%u rate_khz=%u address=50 offset=00 length=%u d014=%08x d008=%08x d000_before=%08x\n",
+		  base->speed_sel, first_rate / 1000, msgs[1].len, saved_d014,
+		  nvkm_rd32(device, d008), d000_before);
+	init_wait_ret = gf119_i2c_hw_wait(device, d000, &init_wait_status);
+	/* The GOP caller ignores this initial wait result. */
+	nvkm_wr32(device, d010, 0x000f4240);
+	nvkm_wr32(device, bus->addr, 0x00000003);
+
+	/* GOP speed setter: program rate, ignore waiter result, then STOP. */
+	d008_before_speed = nvkm_rd32(device, d008);
+	if (first_rate == 400000)
+		nvkm_mask(device, d008, 0x00000fbc, 0x00000043);
+	else
+		nvkm_mask(device, d008, 0x00000ef1, 0x0000010e);
+	speed_wait_ret =
+		gf119_i2c_hw_wait(device, d000, &speed_wait_status);
+	nvkm_wr32(device, d000, 0x8000000c);
+	d008_after_speed = nvkm_rd32(device, d008);
+
+	/* The GOP applies this initializer mask after the speed-setter STOP. */
+	nvkm_mask(device, d008, 0x00f58000, 0x010a0000);
+	d008_after_init = nvkm_rd32(device, d008);
+	nvkm_info(subdev,
+		  "DDC_DIAG: PNVIO_HW_DDC phase=caller-init rate_khz=%u init_wait_ret=%d init_wait_status=%08x speed_wait_ret=%d speed_status=%08x stop_written=1 d008_before_speed=%08x d008_after_speed=%08x d008_after_init=%08x d010=%08x d014=%08x\n",
+		  first_rate / 1000, init_wait_ret, init_wait_status,
+		  speed_wait_ret, speed_wait_status, d008_before_speed,
+		  d008_after_speed, d008_after_init,
+		  nvkm_rd32(device, d010), nvkm_rd32(device, bus->addr));
+
+	/* GOP caller vtable +0x70 recovery must succeed before the read. */
+	caller_recovered =
+		gf119_i2c_hw_recover(bus, &caller_recovery_cycles);
+	nvkm_info(subdev,
+		  "DDC_DIAG: PNVIO_HW_DDC phase=caller-recovery result=%u cycles=%u d014_after=%08x\n",
+		  caller_recovered, caller_recovery_cycles,
+		nvkm_rd32(device, bus->addr));
+
+	if (caller_recovered) {
+		/* The GOP read helper re-enters controller mode after recovery. */
+		nvkm_wr32(device, bus->addr, 0x00000003);
+		primary_attempted = true;
+		first_ret = gf119_i2c_hw_read_attempt(bus, msgs, num, &first);
+		nvkm_info(subdev,
+			  "DDC_DIAG: PNVIO_HW_DDC phase=attempt attempt=primary rate_khz=%u ret=%d bytes=%u chunks=%u failure_stage=%s d000_before=%08x pre_idle_ret=%d pre_idle_status=%08x d004=%08x command=%08x command_status=%08x final_wait_ret=%d final_status=%08x\n",
+			  first_rate / 1000, first.ret, first.bytes, first.chunks,
+			  first.failure_stage, first.d000_before, first.pre_idle_ret,
+			  first.pre_idle_status, first.d004, first.command,
+			  first.command_status, first.final_wait_ret,
+			  first.final_status);
+		ret = first_ret;
+		result_bytes = first.bytes;
+		result_chunks = first.chunks;
+		failure_stage = first.failure_stage;
+
+		/*
+		 * The K4200 GOP retries a failed 400 kHz read at 100 kHz. The only
+		 * admitted transactions are EDID block-0 reads, so this replay is
+		 * limited to the read-only offset-zero probe or base-block read.
+		 */
+		if (first_ret != num && first_rate == 400000) {
+			retry100_attempted = true;
+			bus->hw_speed = 100000;
+
+			retry_d008_before = nvkm_rd32(device, d008);
+			nvkm_wr32(device, d008,
+				  (retry_d008_before & 0xfffff10e) | 0x0000010e);
+			retry_speed_wait_ret =
+				gf119_i2c_hw_wait(device, d000,
+						  &retry_speed_status);
+			/* GOP ignores this wait result and issues STOP before recovery. */
+			nvkm_wr32(device, d000, 0x8000000c);
+			retry_d008_after = nvkm_rd32(device, d008);
+
+			retry_recovered =
+				gf119_i2c_hw_recover(bus, &retry_recovery_cycles);
+			nvkm_info(subdev,
+				  "DDC_DIAG: PNVIO_HW_DDC phase=recovery rate_khz=100 result=%u cycles=%u speed_wait_ret=%d speed_status=%08x d008_before=%08x d008_after=%08x d014=%08x\n",
+				  retry_recovered, retry_recovery_cycles,
+				  retry_speed_wait_ret, retry_speed_status,
+				  retry_d008_before, retry_d008_after,
+				  nvkm_rd32(device, bus->addr));
+
+			if (retry_recovered) {
+				/*
+				 * GOP's recursive read helper sees software mode and
+				 * re-enters hardware mode with D014=3 before D004.
+				 */
+				nvkm_wr32(device, bus->addr, 0x00000003);
+				second_ret =
+					gf119_i2c_hw_read_attempt(bus, msgs, num, &second);
+				nvkm_info(subdev,
+					  "DDC_DIAG: PNVIO_HW_DDC phase=attempt attempt=retry100 rate_khz=100 ret=%d bytes=%u chunks=%u failure_stage=%s d000_before=%08x pre_idle_ret=%d pre_idle_status=%08x d004=%08x command=%08x command_status=%08x final_wait_ret=%d final_status=%08x\n",
+					  second.ret, second.bytes, second.chunks,
+					  second.failure_stage, second.d000_before,
+					  second.pre_idle_ret, second.pre_idle_status,
+					  second.d004, second.command,
+					  second.command_status, second.final_wait_ret,
+					  second.final_status);
+				ret = second_ret;
+				result_bytes = second.bytes;
+				result_chunks = second.chunks;
+				failure_stage = second.failure_stage;
+			} else {
+				failure_stage = "retry-recovery";
+			}
+		}
+	} else {
+		/* Never issue or retry an EDID command without GOP recovery. */
+		ret = -EIO;
+	}
+
+	/* Restore the saved port-control bits after the final attempt. */
+	nvkm_mask(device, bus->addr, 0x00000007, saved_d014 & 0x7);
+
+	nvkm_info(subdev,
+		  "DDC_DIAG: PNVIO_HW_DDC phase=result ret=%d bytes=%u chunks=%u rate_khz=%u primary_attempted=%u retry100_attempted=%u caller_recovery=%u caller_recovery_cycles=%u retry_recovery=%u retry_recovery_cycles=%u primary_ret=%d retry100_ret=%d retry_speed_wait_ret=%d retry_speed_status=%08x failure_stage=%s d014_restored=%08x\n",
+		  ret, result_bytes, result_chunks, bus->hw_speed / 1000,
+		  primary_attempted, retry100_attempted, caller_recovered,
+		  caller_recovery_cycles, retry_recovered, retry_recovery_cycles,
+		  first_ret, second_ret, retry_speed_wait_ret,
+		  retry_speed_status, failure_stage,
+		  nvkm_rd32(device, bus->addr));
+	return ret;
+}
