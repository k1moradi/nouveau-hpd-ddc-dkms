+static int
+nvkm_i2c_bus_hw_xfer(struct i2c_adapter *adap, struct i2c_msg *msgs, int num)
+{
+	struct nvkm_i2c_bus *bus = container_of(adap, typeof(*bus), i2c);
+	struct nvkm_subdev *subdev = &bus->pad->i2c->subdev;
+	int ret;
+
+	/*
+	 * Decide before acquiring the NVKM lock.  i2c_bit_algo.master_xfer()
+	 * invokes bit->pre_xfer/post_xfer, which acquire and release it.
+	 */
+	if (!bus->func->hw_xfer_eligible ||
+	    !bus->func->hw_xfer_eligible(bus, msgs, num)) {
+		if (msgs && num == 2) {
+			const u8 data0 = msgs[0].buf && msgs[0].len ?
+				msgs[0].buf[0] : 0xff;
+
+			nvkm_info(subdev,
+				  "DDC_DIAG: PNVIO_HW_DDC path=bitbang reason=unsupported-shape "
+				  "selector=%u num=2 msg0 addr=%02x flags=%04x len=%u "
+				  "data0=%02x msg1 addr=%02x flags=%04x len=%u\n",
+				  bus->speed_sel, msgs[0].addr, msgs[0].flags,
+				  msgs[0].len, data0, msgs[1].addr, msgs[1].flags,
+				  msgs[1].len);
+		} else {
+			nvkm_info(subdev,
+				  "DDC_DIAG: PNVIO_HW_DDC path=bitbang reason=unsupported-shape selector=%u messages=%d\n",
+				  bus->speed_sel, num);
+		}
+		return i2c_bit_algo.master_xfer(adap, msgs, num);
+	}
+
+	ret = nvkm_i2c_bus_acquire(bus);
+	if (ret)
+		return ret;
+
+	ret = bus->func->hw_xfer(bus, msgs, num);
+	nvkm_i2c_bus_release(bus);
+
+	/*
+	 * -EOPNOTSUPP is reserved for a read-only hardware preflight rejection
+	 * before the controller has started an I2C transaction.
+	 */
+	if (ret == -EOPNOTSUPP) {
+		nvkm_info(subdev,
+			  "DDC_DIAG: PNVIO_HW_DDC path=bitbang reason=preflight selector=%u\n",
+			  bus->speed_sel);
+		return i2c_bit_algo.master_xfer(adap, msgs, num);
+	}
+
+	/* A hardware error may follow a partial read; never replay it. */
+	return ret;
+}
