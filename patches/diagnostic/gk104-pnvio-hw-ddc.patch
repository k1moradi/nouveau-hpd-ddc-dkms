+		ret = gf119_i2c_hw_wait(device, d000, &status);
+		if (ret)
+			break;
+
+		{
+			u32 word = nvkm_rd32(device, d00c);
+			u32 i;
+
+			for (i = 0; i < count; i++)
+				msgs[1].buf[bytes + i] = (word >> (i * 8)) & 0xff;
+		}
