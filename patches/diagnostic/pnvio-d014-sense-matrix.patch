+#include <linux/delay.h>
+
 #define gf119_i2c_bus(p) container_of((p), struct gf119_i2c_bus, base)
 #include "bus.h"
 
 struct gf119_i2c_bus {
 	struct nvkm_i2c_bus base;
 	u32 addr;
+	u8 diag_matrix_samples;
+	bool diag_matrix_active;
 };
+
+static void
+gf119_i2c_bus_diag_sample(struct gf119_i2c_bus *bus, const char *line, int state)
+{
+	struct nvkm_device *device = bus->base.pad->i2c->subdev.device;
+	u32 raw0, raw1, raw2;
+	u8 n;
+
+	if (!bus->diag_matrix_active || bus->addr != 0x00d014 ||
+	    bus->diag_matrix_samples >= 32)
+		return;
+
+	/* Let the normal line transition settle before taking the read-only sample. */
+	udelay(1);
+	raw0 = nvkm_rd32(device, bus->addr);
+	n = ++bus->diag_matrix_samples;
+	if ((raw0 & 0x00000003) == 0x00000003) {
+		raw1 = nvkm_rd32(device, bus->addr);
+		raw2 = nvkm_rd32(device, bus->addr);
+		nvkm_info(&bus->base.pad->i2c->subdev,
+			  "DDC_DIAG: D014_MATRIX port=0 reg=d014 addr=50 "
+			  "n=%u op=%s drive=%s reads=3 "
+			  "raw=%08x,%08x,%08x scl=%d,%d,%d sda=%d,%d,%d\n",
+			  n, line, state ? "release" : "low", raw0, raw1, raw2,
+			  !!(raw0 & 0x00000010), !!(raw1 & 0x00000010),
+			  !!(raw2 & 0x00000010), !!(raw0 & 0x00000020),
+			  !!(raw1 & 0x00000020), !!(raw2 & 0x00000020));
+	} else {
+		nvkm_info(&bus->base.pad->i2c->subdev,
+			  "DDC_DIAG: D014_MATRIX port=0 reg=d014 addr=50 "
+			  "n=%u op=%s drive=%s reads=1 "
+			  "raw=%08x scl=%d sda=%d out=%d,%d\n",
+			  n, line, state ? "release" : "low", raw0,
+			  !!(raw0 & 0x00000010), !!(raw0 & 0x00000020),
+			  !!(raw0 & 0x00000001), !!(raw0 & 0x00000002));
+	}
+}
+
+static void
+gf119_i2c_bus_diag_matrix(struct nvkm_i2c_bus *base, bool active)
+{
+	struct gf119_i2c_bus *bus = gf119_i2c_bus(base);
+
+	if (bus->addr == 0x00d014)
+		bus->diag_matrix_active = active;
+}
 
