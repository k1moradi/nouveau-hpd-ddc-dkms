-                    (unsigned long long)object_id, (unsigned long long)channel_id);
-   nouveau_object_del(&dec->bsp);
-   nouveau_vp3_diag("phase=object-destroy stage=end engine=bsp object_ptr=0x%llx channel_ptr=0x%llx\n",
-                    (unsigned long long)object_id, (unsigned long long)channel_id);
