-                    (unsigned long long)object_id, (unsigned long long)channel_id);
-   object = dec->ppp;
-   channel = dec->channel[2];
-   object_id = (uintptr_t)object;
-   channel_id = (uintptr_t)channel;
-   nouveau_vp3_diag("phase=object-destroy stage=begin engine=ppp object_ptr=0x%llx channel_ptr=0x%llx\n",
-                    (unsigned long long)object_id, (unsigned long long)channel_id);
-   nouveau_object_del(&dec->ppp);
