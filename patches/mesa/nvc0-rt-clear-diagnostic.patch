From: Nouveau debugging notes
Subject: [DIAGNOSTIC] gallium/nouveau: trace NVC0 render-target clears

Opt-in trace for the NVC0 render-target state emitted by
nvc0_clear_render_target(). This is diagnostic only and is not integrated
into the Nouveau DKMS build.

Enable for one Mesa test process with:
  NOUVEAU_DIAG_RT_CLEAR=1

--- a/src/gallium/drivers/nouveau/nvc0/nvc0_surface.c
+++ b/src/gallium/drivers/nouveau/nvc0/nvc0_surface.c
@@ -34,2 +34,3 @@
 #include "util/u_surface.h"
+#include "util/u_debug.h"
 #include "util/u_thread.h"
@@ -302,3 +302,12 @@
    assert(dst->texture->target != PIPE_BUFFER);
-
+
+   if (debug_get_bool_option("NOUVEAU_DIAG_RT_CLEAR", false)) {
+      debug_printf("NOUVEAU_DIAG_RT_CLEAR ctx=%p format=%u rt_format=%02x "
+                   "rt=%ux%u clear=%u,%u %ux%u layers=%u..%u\n",
+                   (void *)nvc0, dst->format,
+                   nvc0_format_table[dst->format].rt,
+                   sf->width, sf->height, dstx, dsty, width, height,
+                   dst->first_layer, dst->last_layer);
+   }
+
    if (!PUSH_SPACE(push, 32 + sf->depth))
